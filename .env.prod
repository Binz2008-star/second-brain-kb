# Production Environment Configuration
# Copy to .env.prod and fill in actual values. Never commit this file.

# Database (Production PostgreSQL)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Ollama (Production endpoint)
OLLAMA_EMBED_URL=http://<ollama-host>:11434/api/embed
OLLAMA_CHAT_URL=http://<ollama-host>:11434/api/chat

# Embedding
EMBED_MODEL=nomic-embed-text

# Payment processing
PADDLE_STRIPE_ENV=production

# GHCR (GitHub Container Registry)
GHCR_TOKEN=ghp_your_token_here

# App
CURRENT_PROJECT=rico
